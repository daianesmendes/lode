# Copy to .env and fill in. .env is ignored by git.
DATABASE_URL=postgresql://localhost:5432/lode
LODE_WEB_ORIGINS=http://localhost:3000

# LLM for the website check, in the order chosen on the dev split (see README): Groq's
# gpt-oss-120b first, then Gemini. Keys come from console.groq.com and Google AI Studio.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODELS=openai/gpt-oss-120b
LLM_REASONING_EFFORT=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview
LLM_FALLBACK_REASONING_EFFORT=low
