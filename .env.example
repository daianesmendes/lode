# Copy to .env and fill in. .env is ignored by git.
DATABASE_URL=postgresql://localhost:5432/lode
LODE_WEB_ORIGINS=http://localhost:3000

# LLM for the website check: an OpenAI-compatible API (Gemini) and a fallback (Groq).
# Keys come from Google AI Studio and console.groq.com. Never commit them.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODELS=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODELS=
